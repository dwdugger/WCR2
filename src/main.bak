/**************************************************************************************
 ********************************  SETUP  *********************************************
 **************************************************************************************/

void setup()
{
  ESPSketchSize = ESP.getSketchSize(); // Size of the sketch in bytes

  coldSetupPControl();     // Setup the control block with default values and read from FRAM if available
  taskSchd.init();               // Initialize the task scheduler
  taskSchd.addTask(tShowMatrix); // Add the showMatrixTask to the scheduler

#ifdef DEBUG1
                           // Initialize Serial port
  Serial.begin(115200);
  pinMode(LED_BUILTIN, OUTPUT);
  delay(2000); // comment out, delay to allow time for serial to start
  while (!Serial)
  {
    digitalWrite(LED_BUILTIN, 1); // Blink while waiting for Serial
    delay(100);
    digitalWrite(LED_BUILTIN, 0);
  }
  digitalWrite(LED_BUILTIN, 0);

  debugln("\nSerial is ready");
#endif

  // Wire.begin(); // Start I2C
  initPCIInterruptForTinyReceiver(); // Start the PCI interrupt for the IR receiver using IR_RECIVE_PIN = A4

  statusColdSetupRTC = coldSetupRTC();
  if (!statusColdSetupRTC) // RTC setup failed
  {
    debugln("Sorry RTCsetup failed");
    matrixErrorPrint("RTC setup failed.");
    while (1) // no need to recover from RTC failure
              // really can't recover from RTC failure as what good is a clock
      ;       // that does not keep time?
  }
  else
  {
    debugln("RTCsetup successful");
  }

  statusColdSetupDisplayMatrix = coldSetupDisplayMatrix();
  if (!statusColdSetupDisplayMatrix)
  {
    debugln("Sorry displayMatrixSetup failed");
    while (1) // can not recover from display failure so hang forever. If we can not see we can not continue.
      ;
  }
  else
  {
    debugln("displayMatrixSetup successful");
  }
  // SoundOffMorse("V"); // Send a V for victory to the buzzer

subProgramStartup(); // Run the startup program to show something on the display while setup continues

  statusColdSetupFRAM = coldSetupFRAM();
  if (!statusColdSetupFRAM) // if FRAM setup failed
  {
    debugln("Sorry FRAM setup failed");
    matrixErrorPrint("FRAM setup failed.");
    while (1) // no need to recover from FRAM failure as we can not save settings or data without FRAM, so hang forever.
      ;
  }
  else
  {
    debugln("FRAM setup successful");
  }

  fram.read(dControl.bBlockADDR, (u8_t *)&bBlock, sizeof(bBlock)); // Read the BBlock structure from FRAM

  subProgramStartup(); // Run the startup program again to update the display with any changes from FRAM read

#ifdef WUNDER_CLOCK
  statusFactoryReset= true; // Set to true to reset WiFi settings and other settings to defaults on first compile
  bBlock.bootMode = 3; // Set boot mode to factory reset on first compile
#endif

  if (bBlock.bootMode == 3 || statusFactoryReset) // Factory reset if boot mode is 3 or statusFactoryReset flag is true
  {
    factoryReset();
  }

  if (cBlock.wifiActive)
  {
    // Connect to WiFi
    statusColdSetupWifi = coldSetupWifi();
    if (!statusColdSetupWifi)
    {
      debugln("Sorry WiFi setup failed");
      matrixErrorPrint("WiFi setup failed.");
    }
    else
    {
      debugln("WiFi setup successful");
    }
  }

subProgramStartup(); // Run the startup program again to update the display with any changes from WiFi setup

  if (cBlock.ntpActive && cBlock.wifiActive && statusColdSetupWifi)
  {
#ifdef DEBUG3
    setDebug(DEBUG); // Set debug level to DEBUG
                     // setDebug(ERROR); // Set debug level to ERROR
#endif

    statusColdSetupNTP = coldSetupNTP();
    if (!statusColdSetupNTP)
    {
      debugln("Sorry NTP setup failed");
      matrixErrorPrint("NTP setup failed.");
    }
    else
    {
      debugln("NTP setup successful");
    }
  }
  else
  {
    debugln("NTP setup skipped");
  }

  if (cBlock.gnssActive)
  {
    statusColdSetupGNSS = coldSetupGNSS();
    if (!statusColdSetupGNSS) // GNSS setup failed
    {
      debugln("Sorry GNSS setup failed");
      matrixErrorPrint("GNSS setup failed.");
    }
    else
    {
      debugln("GNSS setup successful");
    }
  }

  if (cBlock.gnssActive && statusColdSetupGNSS)
  {
    // Read GNSS data to get location
    statusReadGNSSData = readGNSSData();
    if (!statusReadGNSSData)
    {
      debugln("Sorry GNSS read failed");
      matrixErrorPrint("GNSS read failed.");
    }
    else
    {
      debugln("GNSS read successful");
    }
  }

subProgramStartup(); // Run the startup program again to update the display with any changes from GNSS data

  if (cBlock.googleTZAPIActive && cBlock.wifiActive && statusColdSetupWifi)
  {
    // Get Timezone from Google Timezone API
    // Uses latitude, longitude, and current time UTC
    debugln("Getting Timezone from Google Timezone API");
    // Add code to get timezone from Google Timezone API
    statusReadGoogleTZAPI = readGoogleMapsTZAPI();

    if (!myTZ.setCache(dControl.TZADDR)) // Set the timezone cache defaut is  0x400
    {
      debugln("Timezone cache was not set, will set");

      if (statusReadGoogleTZAPI)
      {
        debugln("GoogleMapsTZAPI good");
        myTZ.setLocation(timeZoneId); // Set the timezone to the one returned from Google Maps API
      }
      else
      {
        debugln("GoogleMapsTZAPI failed, using default timezone");
        matrixErrorPrint("GoogleMapsTZAPI failed");
        myTZ.setLocation(cBlock.timeZoneId); // Set the timezone to the default in control block, default is "America/Denver"
      }
    }
    else
    {
      debugln("Timezone cache set");
    }

    debugln("Setting timezone to: " + myTZ.getPosix());
    myTZ.setDefault();
    NOW = myTZ.now();
    RTClock.adjust(NOW);            // Set the RTC to the current time from the timezone object
    resolvedLocalTime = myTZ.now(); // Resolve timezone and DST
    UTCNOW = UTC.now();             // Get the current time from the timezone object

    debug("Unix time:    ");
    debugln(UTCNOW.unixtime());
    debugln("UTC:             " + UTCNOW.timestamp(DateTime::TIMESTAMP_FULL));
    //debugln("myTZ:             " + myTZ.timestamp(DateTime::TIMESTAMP_FULL));
    debugln("RTClock:       " + RTClock.now().timestamp(DateTime::TIMESTAMP_FULL));
    debug("gnssunixtime:            ");
    debugln(gnssNow.unixtime());
    debugln("Timezone:        " + myTZ.getPosix());
    debugln("Timezone Name:   " + myTZ.getTimezoneName());
    debug("Timezone Offset: ");

    TZOffsetMin = myTZ.getOffset();
    debugln(TZOffsetMin);

    if (myTZ.isDST())
    {
      debugln("DST is in effect");
      cBlock.dstCurrent = true;
    }
    else
    {
      debugln("DST is not in effect");
      cBlock.dstCurrent = false;
    }
  }
  else
  {
    debugln("WiFi not connected, NTP not set up, must set clock manually");
  }

  statusColdSetupBME280 = coldSetupBME280();
  if (!statusColdSetupBME280) // BME280 setup failed
  {
    debugln("Sorry BME280setup failed");
    matrixErrorPrint("BME280setup failed"); // Print to display failed
  }
  else
  {
    debugln("BME280 setup successful");
  }

  if (statusColdSetupBME280 && cBlock.bme280Active)
  {
    // Read BME280 data
    statusReadBME280Data = readBME280Data();
    if (!statusReadBME280Data)
    {
      debugln("Sorry BME280 read failed");
      matrixErrorPrint("BME280 read failed.");
    }
    else
    {
      debugln("BME280 read successful");
    }
  }

  statusColdSetupAstro = coldSetupAstro();
  if (!statusColdSetupAstro) // Astro setup failed
  {
    debugln("Sorry Astro setup failed");
    matrixErrorPrint("Astro setup failed"); // Print to display failed
  }
  else
  {
    debugln("Astro setup successful");
  }

  if (statusColdSetupAstro && cBlock.astroActive)
  {
    // Read Astro data
    statusReadAstroData = readAstroData();
    if (!statusReadAstroData) // Astro read failed
    {
      debugln("Sorry Astro read failed");
      matrixErrorPrint("Astro read failed"); // Print to display failed
    }
    else
    {
      debugln("Astro read successful");
    }
  }

  if (cBlock.otaActive && cBlock.wifiActive && statusColdSetupWifi)
  {
    statusColdSetupWebServer = coldSetupWebServer();
    if (!statusColdSetupWebServer)
    {
      debugln("Sorry Web Server setup failed");
      matrixErrorPrint("Web Server setup failed"); // Print to display failed
    }
    else
    {
      debugln("Web Server setup successful");
    }
  }
  else
  {
    debugln("ElegantOTA setup skipped");
  }

  if (cBlock.owocActive && cBlock.wifiActive && statusColdSetupWifi)
  {
    statusColdSetupOWOC = coldSetupOWOC();
    if (!statusColdSetupOWOC) // OWOC setup failed
    {
      debugln("Sorry OWOC setup failed");
      matrixErrorPrint("OWOC setup failed"); // Print to display failed
    }
    else
    {
      debugln("OWOC setup successful");
    }
  }

  if (statusColdSetupOWOC && cBlock.owocActive)
  {
    // Read OWOC data
    statusReadOWOCData = readOWOCData();
    if (!statusReadOWOCData) // OWOC read failed
    {
      debugln("Sorry OWOC read failed");
      matrixErrorPrint("OWOC read failed."); // Print to display failed
    }
    else
    {
      debugln("OWOC read successful");
    }
  }

  debug("Size of DateTime: ");
  debugln(sizeof(DateTime));
  debug("Size of time_t: ");
  debugln(sizeof(time_t));
  debug("Size of myTZ: ");
  debugln(sizeof(myTZ));
  debug("Size of bBlock: ");
  debugln(sizeof(bBlock));
  debug("Size of cBlock: ");
  debugln(sizeof(cBlock));
  debug("Size of irCurrent: ");
  debugln(sizeof(irCurrent));
  debug("Size of int: ");
  debugln(sizeof(int));
  debug("Size of long: ");
  debugln(sizeof(long));
  debug("Size of short: ");
  debugln(sizeof(short));
  debug("Size of float: ");
  debugln(sizeof(float));
  debug("Size of double: ");
  debugln(sizeof(double));
  debug("Size of pControl: ");
  debugln(sizeof(pControl));
  debug("Size of  dControl: ");
  debugln(sizeof(dControl));

  /////////////////////////
  debugln("Setup complete");
} // end setup

/**************************************************************************************
 *********************************  LOOP  *********************************************
 *************************************************************************************/

void loop()
{
  // put your main code here, to run repeatedly:
  //
  //
  u8_t progMode = cBlock.programMode;
  // cBlock.programMode = 3;

  if (bBlock.bootMode <= 1)
  {
    taskSchd.execute(); // Execute scheduled tasks
    events();     // Call the events function to handle any events that have occurred
    irLoop();
    // irMenu(pControl[cBlock.programMode].irMenuLevel); // Handle the IR menu system, pass in the current menu level from the control block
    ElegantOTA.loop(); // Handle Over The Air (OTA) updates

    // Check Local Time to see if it is housekeeping time
    if (!HouseKeeping)
    {
      if (myTZ.hour() == 3 && myTZ.minute() == 15 && myTZ.isAM()) // 3:15 AM local time
      {
        debugln("Housekeeping time, do something here");
        updateBlocks(); // Update the data block in the FRAM with the new values
        debugln("Blocks updated");
        // Do something here, like update the NTP server or do some other housekeeping task
        // or just do nothing and let the clock run
        HouseKeeping = true;
      }
    }
    else if (myTZ.hour() == 3 && myTZ.minute() == 30 && myTZ.isAM()) // 3:30 AM local time
    {
      HouseKeeping = false; // Reset the housekeeping flag
      debugln("Housekeeping done, reset flag");
    }

    if (cBlock.wifiActive && statusColdSetupWifi && (WiFi.status() != WL_CONNECTED))
    {
      debugln("WiFi NOT connected");
      wm.autoConnect(); // Attempt to reconnect to WiFi if it is not connected
    }
  }

  switch (progMode)
  {
  case 0:
    // debug("Menu Level: ");
    // debugln(menuLevel);
    // setupWunderClock_Menu(menuLevel); // Main setup menu
    programClock(cBlock.clock24hr); // Main clock program, pass in true for 24 hour clock, false for 12 hour clock

    break;
  case 1:
    programClock(cBlock.clock24hr); // Main clock program, pass in true for 24 hour clock, false for 12 hour clock
    break;
  case 2:
    programWeather();
    break;
  case 3:
    programAstroData();
    break;
  case 4:
    programSystemStatus();
    break;
  case 5:
    subProgramStartup();
    break;
  case 6:
    programTester();
    break;
  case 7:
    // videoTests_Menu();
    programClock(cBlock.clock24hr); // Main clock program, pass in true for 24 hour clock, false for 12 hour clock

    break;
  case 8:
    // tester2();
    programClock(cBlock.clock24hr); // Main clock program, pass in true for 24 hour clock, false for 12 hour clock

    break;
  case 9:
    // controledRestart();
    programClock(cBlock.clock24hr); // Main clock program, pass in true for 24 hour clock, false for 12 hour clock

    break;
  default:
    break;
  }

  ////////////////////////////////////////////////
  // delay(1000); // Delay for 1 second before next update

  irCurrent.command = 0; // Clear the current IR command after processing

} // end loop

