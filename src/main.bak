bool coldSetupFRAM()
{
  // Start the LittleFS file system
  statusLittleFS = LittleFS.begin(true); // Initialize LittleFS and store the status
  if (!statusLittleFS)                   // If LittleFS failed to start
  {
    debugln("LittleFS failed to start");
    matrixErrorPrint("LittleFS failed to start"); // Print to display
    while (1)                                     // can not recover from LittleFS failure so hang forever.
      ;
  }
  else
  {
    debugln("LittleFS started successfully");
  }

  // begin FRAM
  if (!fram.begin(FRAM_I2C_ADDRESS)) // Initialize the FRAM
  {
    debugln("FRAM not found");
    matrixErrorPrint("FRAM not found"); // Print to display
    while (1)                           // can not recover from FRAM failure so hang forever.
      ;
  }
  else
  {
    debugln("FRAM found");
  }
  // Add code to initialize FRAM
  return true; // Return true if setup is successful
} // end coldSetupFRAM()

bool coldSetupBME280()
{

  debugln("BME280 setup");
  // Set up BME280                                    // I2C
  statusColdSetupBME280 = bme.begin(BME280_ADDRESS, &Wire); // Start the BME280 for temperature, humidity and pressure.
  if (!statusColdSetupBME280)
  { // BME280 setup failed
    debugln("Sorry BME280setup failed");
    // matrixErrorPrint("BME280setup failed"); // Print to display failed
    return false;
  }
  debugln("Found BME280 sensor!");

  return true; // Return true if setup is successful
} // end coldSetupBME280()

bool readBME280Data()
{
  EVENT_JOB_BME280 = setEvent(cronSetupBME280, myTZ.now() + 300); // Set an event to retry the BME280 setup in 5 minutes
  if (EVENT_JOB_BME280 >= 1 && EVENT_JOB_BME280 <= 8)
  {
    debug("BME280 event ");
    debug(EVENT_JOB_BME280);
    debugln(" running again in 5 minutes");
  }
  else
  {
    debugln("Failed to set BME280 event");
  }
  // Add code to read data from BME280 sensor
  clockTemp_C = bme.readTemperature();
  clockTemp_F = clockTemp_C * 9.0 / 5.0 + 32.0;
  clockPressure_hPa = bme.readPressure() / 100.0F;        // Read the pressure from the BME280 in Pascals then convert to hPa
  clockPressure_inHg = clockPressure_hPa * 0.02953;       // Convert to inches of mercury
  clockPressure_mmHg = clockPressure_hPa * 0.750062;      // Convert to mm of mercury
  clockAltitude = bme.readAltitude(SEALEVELPRESSURE_HPA); // Read the altitude from the BME280 in meters
  clockHumidity = bme.readHumidity();                     // Read the humidity from the BME280 in percent

  debug("BME280 Temperature: ");
  debug(clockTemp_F);
  debug(" F / ");
  debug(clockTemp_C);
  debugln(" C");
  debug("BME280 Pressure: ");
  debug(clockPressure_hPa);
  debug(" hPa / ");
  debug(clockPressure_inHg);
  debug(" inHg / ");
  debug(clockPressure_mmHg);
  debugln(" mmHg");
  debug("BME280 Altitude: ");
  debug(clockAltitude);
  debugln(" m");
  debug("BME280 Humidity: ");
  debug(clockHumidity);
  debugln(" %");

  return true; // Return true if read is successful
} // end readBME280Data()

bool warmSetupBME280()
{
  // Add code for warm setup of BME280 sensor
  return true; // Return true if setup is successful
} // end warmSetupBME280()

void cronSetupBME280()
{
  // Add code for cron setup of BME280 sensor

  debugln("cronSetupBME280 called");
  if (readBME280Data()) // Try to get the BME280 data with a timeout of 60 seconds
  {
    debugln("BME280 data retrieved successfully");
    statusReadBME280Data = true; // Set the BME280 status to true
                                 // CBlock.BME280LastUpdate = myTZ.now(); // Update the last BME280 update time
    updateBlocks();              // Update the CBlock structure in FRAM
  }
  else
  {
    debugln("BME280 data retrieval failed");
    statusReadBME280Data = false; // Set the BME280 status to false
  }
} // end cronSetupBME280()

bool coldSetupRTC()
{

  if (!RTClock.begin())
  {
    debugln("RTC begin failed");
    return false;
  }
  debugln("RTC begin successful");

  // Check if RTC is valid if not set to compile time so we have valid time
  NOW = RTClock.now();
  if (NOW.isValid())
  {
    debugln("RTC is valid");
  }
  else
  {
    debugln("RTC is NOT valid setting to compile time");
    RTClock.adjust(DateTime(F(__DATE__), F(__TIME__))); // sets RTC to compile time
    NOW = RTClock.now();                                // set time now that we know RTC is valid
  }

  // Add code to initialize RTC
  return true; // Return true if setup is successful
} // end coldSetupRTC()

bool coldSetupNTP()
{
  bool res;
  setServer(NTP_SERVER); // Set the NTP server, default is pool.ntp.org
  res = waitForSync(30); // Wait for NTP sync, timeout is 30 seconds
  return res;            // Return true if setup is successful
} // end coldSetupNTP()

