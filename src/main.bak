void cronSetupOWOC()
{
  if (readOWOCData())
  {
    debugln("Weather data read successfully in cron job");
    statusReadOWOCData = true; // Set the status flag to true if data was read successfully
  }
  else
  {
    debugln("Failed to read weather data in cron job");
    statusReadOWOCData = false; // Set the status flag to false if data was not read successfully
  }

} // End cronSetupOWOC()

bool coldSetupWebServer()
{
  // Add code to set up the web server and define the routes for the web interface
  ElegantOTA.begin(&server);

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request)
            { request->send(200, "text/plain", "This is Wunderclock!"); });

  server.begin(); // Start the web server  url is http://<IP_ADDRESS>/ and OTA updates are at http://<IP_ADDRESS>/update

  return true; // Return true if setup is successful
} // End coldSetupWebServer()

void coldSetupPControl()
{
  // Add code to set up the program control structure and initialize the program modes
  for (int i = 0; i < 10; i++)
  {
    pControl[i].program = i;           // Set all program modes to inactive
    pControl[i].programActive = false; // Set all program modes to inactive
    pControl[i].subProgram = 0;        // Initialize other fields as needed
    pControl[i].subProgramActive = false;
    pControl[i].subProgramTotal = pControlSubProgramTotal[i];
  }

  return;
} // End coldSetupPControl()

void factoryReset()
{
  // Add code to reset the device to factory settings
  // This may include resetting the EEPROM, clearing any stored data, and resetting any flags or settings to their default values

  debugln("Factory reset initiated");
  matrixErrorPrint("Factory reset initiated");

  statusColdSetupNVS = pref.begin("eeprom"); // Start Preferences with namespace "eeprom" and readOnly = false
  if (!statusColdSetupNVS)                   // NVS setup failed
  {
    debugln("Sorry NVS setup failed");
    matrixErrorPrint("NVS setup failed.");
    while (1) // no need to recover from NVS failure as we can not save settings without NVS, so hang forever.
      ;
  }
  else
  {
    debugln("NVS setup successful");
  }

  // u8_t clearBytes[4096] = {0}; // Array of bytes to write to FRAM to clear settings, adjust size as needed
  bBlock.bootMode = 0; // Set boot mode to default
                       // wm.resetSettings();
  myTZ.clearCache();   // Clear timezone cache
  delay(3000);         // Delay to ensure cache is cleared before writing to FRAM
  if (!pref.clear())
  {
    debugln("Failed to clear all preferences in NVS");
    matrixErrorPrint("Failed to clear NVS");
  } // Clear all preferences in NVS
  // pref.putBytes("eeprom", &clearBytes, sizeof(clearBytes)); // Clear the BBlock in NVS
  pref.end(); // Close Preferences to ensure data is written

  // wm.resetSettings(); // Reset WiFi settings
  // Add any other settings resets here as needed
  //  bBlock.bootMode = 0; // Set boot mode to cold boot after factory reset
  //  statusFactoryReset = false;
  updateBlocks(); // Update blocks to save factory reset status
  esp_restart();  // Restart the ESP to complete factory reset

  return;
} // End factoryReset()

