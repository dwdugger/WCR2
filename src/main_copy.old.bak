void setupWunderClock_Menu(u8_t passLevel)
{
  // Boot state
  /* Need to check */

  if (BBlock.bootMode != 2)
  {
    BBlock.bootMode = 2;    // Set the boot mode to normal
    CBlock.ProgramMode = 0; // Set the program mode to normal
    menuLevel = 0;
    updateBlocks(); // Update the BBlock structure in FRAM so we skip this next time
    //  controledRestart(); // Restart the system to enter the setup menu
  }

  // BBlock.bootMode = 0; // Set the boot mode to normal
  // CBlock.ProgramMode = 1; // Set the program mode to normal
  // updateBlocks();    // Update the BBlock structure in FRAM

  menuLevel = passLevel;
  IRMenu(2); // Call the IR menu function to handle IR commands

  if (!menuTempFlag1)
  {
    matrix.fillScreen(0);
    matrix.setFont(0);
    matrix.setTextSize(1);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.setCursor(2, 0);
    if (activeMenuElement == 0)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Wunder");
    matrix.setCursor(2, 8);
    if (activeMenuElement == 1)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Clock");
    matrix.setCursor(2, 16);
    if (activeMenuElement == 2)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Location");
    matrix.setCursor(2, 24);
    if (activeMenuElement == 3)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Menu Order");
    matrix.setCursor(2, 32);
    if (activeMenuElement == 4)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Exit");

    matrix.setCursor(2, 40);
    matrix.setTextColor(CYAN, BLACK);
    matrix.print("Use U/D to");
    matrix.setCursor(2, 48);
    matrix.print("select");
    matrix.setCursor(2, 56);
    matrix.print("OK = enter");
    matrix.setTextColor(MYYELLOW2, BLACK);
  }

  /*********************************************************************************/

  if (menuTempFlag1)
  {
    switch (activeMenuElement)
    {
    case 0:
      setupWunderClock_Sub(menuLevel); // WunderClock main menu
      break;
    case 1:
      setupClock_Sub(menuLevel); // Clock display
      break;
    case 2:
      setupLocation_Sub(menuLevel); // Location display
      break;
    case 3:
      setupMenuRotate_Sub(menuLevel); // Menu rotate display

      break;
    case 4:
      menuLevel = 0;
      exit_Sub(); // Exit menu

      break;
    default:
      menuLevel = 0;
      // should not get here
      break;
    }
  }

  if (menuLevel == 0)
  {
    if (!IRrepeat && IRcommand == IRU)
    {
      if (activeMenuElement == 0)
        activeMenuElement = 4;
      else
        activeMenuElement = (activeMenuElement - 1) % 5; // Up button
    }
    if (!IRrepeat && IRcommand == IRD)
    {
      activeMenuElement = (activeMenuElement + 1) % 5; // Down button
    }

    if (!IRrepeat && IRcommand == IROK)
    {
      menuTempFlag1 = true; // OK button
      menuLevel = 1;
    }

    matrix.show();
  }

} // End setupWunderClock_Menu()

