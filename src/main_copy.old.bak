void controledRestart()
{

  //  need to set CBlock.WarmBoot to true here
  //  CBlock.WarmBoot = true; // Set the WarmBoot flag to true in the CBlock structure
  updateBlocks(); // Update the CBlock structure in FRAM

  matrixErrorPrintln("Restarting..."); // Print a message to the matrix display
  delay(2000);                         // Wait for 5 seconds before restarting

  esp_restart();
} // End controledRestart()

bool isMoonVisable()
{
  // return true;
  double latitude = gnssLat;
  double longitude = gnssLong;

  time_t t = makeTime(UTC.hour(), UTC.minute(), UTC.second(), UTC.day(), UTC.month(), UTC.year());

  moonRise.calculate(latitude, longitude, t);

  // Returned values:
  bool isMoonVisible = moonRise.isVisible;

  return isMoonVisible;
} // End isMoonVisable()

void GNSSGetSetEvent()
{

  // This function is called by the event system to retry the GNSS setup
  // after a certain period of time.

  debugln("GNSSGetSetEvent called");
  if (GNSSGet(5000, true)) // Try to get the GNSS data with a timeout of 60 seconds
  {
    debugln("GNSS data retrieved successfully");
    status_GNSSGet = true;              // Set the GNSS status to true
    CBlock.GNSSLastUpdate = myTZ.now(); // Update the last GNSS update time
    updateBlocks();                     // Update the CBlock structure in FRAM
  }
  else
  {
    debugln("GNSS data retrieval failed");
    status_GNSSGet = false; // Set the GNSS status to false
  }
} // End GNSSGetSetEvent()

void doMenuRotate()
{
  // This function is used to rotate the menu items
  uint8_t menuPos;
  debug("menuPos: ");
  debugln(menuPos);                                     // Print the menu position to the serial monitor
  menuPos = CBlock.menuRotateArray[menuRotateArrayPos]; // Get the first menu number from the array
  debug("menuPos: ");
  debugln(menuPos); // Print the menu position to the serial monitor
  if (menuPos == 0) // If the menu position is greater than 9
  {
    menuRotateArrayPos = 0; // Reset the menu position to 0
    debugln("Bloop");
    menuPos = CBlock.menuRotateArray[menuRotateArrayPos];
  }
  menuRotateArrayPos++;         // Increment the menu position
  CBlock.ProgramMode = menuPos; // Set the program mode to the menu position
  debug("menuPos: ");
  debugln(menuPos); // Print the menu position to the serial monitor
  debug("CBlock.menuRotateArray[0]: ");
  debugln(CBlock.menuRotateArray[0]);
  debug("CBlock.menuRotateArray[1]: ");
  debugln(CBlock.menuRotateArray[1]);
  debug("CBlock.menuRotateArray[10]: ");
  debugln(CBlock.menuRotateArray[10]);

  debug("CBlock.menuRotateArray[menuRotateArrayPos]: ");
  debugln(CBlock.menuRotateArray[menuRotateArrayPos]);
  debug("menuRotateArrayPos: ");
  debugln(menuRotateArrayPos); // Print the menu position to the serial monitor
  debug("CBlock.ProgramMode: ");
  debugln(CBlock.ProgramMode); // Print the program mode to the serial monitor

  EVENT_JOB_ROTATE = setEvent(doMenuRotate, myTZ.now() + CBlock.menuRotateTime); // Create a job to rotate the menu
  if (EVENT_JOB_ROTATE >= 1 && EVENT_JOB_ROTATE <= 8)
  {
    debug("EVENT_JOB_ROTATE created, job number: ");
    debugln(EVENT_JOB_ROTATE); // Print the job number to the serial monitor
  }
  else
  {
    debug("EVENT_JOB_ROTATE creation failed");
  }

  debugln("doMenuRotate called");

} // End doMenuRotate()

