  bool tempCharNextValid = false; // next character is valid
  u8_t i = 0;                     // index for the string to be played
  u8_t j = 0;                     // index for the morse code table
  u8_t k = 0;                     // index for the morse code string

  morseCodeChar = WhatToKey; // string to be played
  debug("morseCodeChar: ");
  debugln(morseCodeChar);

  // Loop through the string and convert to morse code
  for (i = 0; i < morseCodeChar.length(); i++) //  outer loop through the whole string
  {
    tempChar = morseCodeChar.charAt(i);          // get the character at the index
    tempCharNext = morseCodeChar.charAt(i + 1);  // get the next character
    tempCharNext2 = morseCodeChar.charAt(i + 2); // get the next character
    tempCharNextValid = tempCharNext != '\0';    // check if next character is valid
    workingChar = toupper(tempChar);             // set the working character

    if (workingChar == ' ') // check for space
    {
      delay(WORD_SPACE); // wait for the space between words
      debugln("WordSpace");
      continue; // skip the space character
    }

    debug("workingChar: ");
    debugln(workingChar); // print the character

    if (prosign) // check for end of prosign
    {
      if (workingChar == '\\')
      {
        prosign = false; // clear the prosign flag
        continue;        // skip the prosign character
      }
    }
    if (workingChar == '\\') // check for prosign
    {
      prosign = true; // set the prosign flag
      continue;       // skip the prosign character
    }

    debug("prosign: ");
    debugln(prosign);

    for (j = 0; j < charMatrixSize; j++) //  first inner loop to find each character in fullcode table
    {
      if (fullCode[j][1] == String(workingChar)) // checking the character in the morse code table
      {
        debug("fullCode[j][1]: ");
        debugln(fullCode[j][1]);
        debug("J:  ");
        debugln(j);
        debug("morseCodeDit: ");
        morseCodeDit = fullCode[j][0]; // get the morse code string for the character
        debugln(morseCodeDit);         // morse code string to be played, Dits and Dahs

        // Loop through the morse code string and play the dit and dah
        debug("morseCodeDit.length(): ");
        debugln(morseCodeDit.length()); // length of the morse code string

        for (k = 0; k < morseCodeDit.length(); k++) // innermost loop to play each DIT and DAH
        {
          if (morseCodeDit.charAt(k) == '.') // check for dit
          {
            buzzer.on();                       // turn on the buzzer
            buzzer.configureBuzzer(tone, DIT); // play the tone for the dit length
            delay(DIT);
            debugln("Dit");
            buzzer.off(); // stop the tone
          }
          else if (morseCodeDit.charAt(k) == '-') // check for dah
          {
            buzzer.on();                       // turn on the buzzer
            buzzer.configureBuzzer(tone, DAH); // play the tone for the dah length
            delay(DAH);
            debugln("Dah");
            buzzer.off(); // stop the tone
          }
          if (k + 1 != morseCodeDit.length()) // check for end, if not last element in string put in space
          {
            delay(SPACE); // wait for the space between letters
            debugln("Space");
          }
        } // one character of morse code done on to the next bit innermost loop done

      } // end of if statment for finding each character in fullcode table

    } // end of first inner loop to find each character in fullcode table. If we did not find the character in the table then we do not play anything.

    // to get spacing between letters and words in every case, this is a bit of a hack and not the best way to do this.
    // I need to check for the prosign and if the next character is a space or not, if it is a space then we are at the end of the prosign.
    // this whole thing is FUBAR. Maybe I should just use a state machine to do this.
    if (prosign && tempCharNext != '\\') // check if still in prosign
    {
      delay(SPACE); // still in prosign, wait for the space between elements
      debugln("prosign Space");
    }
    else if (prosign && tempCharNext == '\\' && tempCharNext2 != ' ') // check for space beyound end of prosign if prosign is set
    {
      delay(CHAR_SPACE); // wait for the space between characters
      debugln("prosign CharSpace");
    }
    else if (prosign && tempCharNext == '\\' && tempCharNext2 == ' ') // check for space beyound end of prosign if prosign is set
    {
      debugln("prosign !WordSpace"); // do nothing as will be caught by outer loop
    }
    else if (prosign && tempCharNext == '\\' && tempCharNext2 == '\\') // starting new prosign after this prosign
    {
      delay(CHAR_SPACE); // wait for the space between characters
      debugln("prosign CharSpace");
    }
    else if (tempCharNext == ' ')
    {
      debugln("prosign '  '"); // do nothing as will be caught by outer loop
    }
    else if (tempCharNext != ' ')
    {
      delay(CHAR_SPACE); // wait for the space between characters
      debugln("CharSpace");
    }

  } // end of outer loop through the whole string

  return true;
} // End SoundOffMorse()
*/

void Clock_Menu(u8_t ClockType, bool Clock24hr) // ClockType = 0 = 64x64, 1 = 128x64, 2 = 64x128
{

  // Draw clock to canvas

  // Set up variables for the clock display

  char timeBuffer[12]; // Holds formatted time string
  int indent;          // Left margin for prints to screen
  char AMPM;
  u8_t Hour;
  NOW = myTZ.now();
  Hour = NOW.hour();
  Clock24hr = false; // Force 24 hour for testing
  u8_t Font = CBlock.fontChoiceClock;
  Font = 1;
  if (!Clock24hr)
  {
    if (Hour == 0)
      Hour = 12;
    if (Hour > 12)
      Hour -= 12;
    AMPM = 'A';
    if (NOW.isPM())
      AMPM = 'P';
  }

  String dayOfWeek;
  u8_t dayOfWeekLength = 0;             // Length of the day of the week string
  dayOfWeek = myTZ.dateTime("l");       // Get the day of the week from the timezone object. That's a lowercase L
  dayOfWeekLength = dayOfWeek.length(); // Get the length of the day of the week string

  canvas.fillScreen(BLUE); // Erase the screen
  canvas.setTextColor(YELLOW);

  IRMenu(1);

  if (Font == 1)
  {
    // canvas.setFont(&Orbitron_Bold_16);
    // canva.setFont(&Cousine_Regular_16);
    // canvas.setFont(0);
    // canvas.setFont(&Cousine_Bold_Italic_16);
    // canvas.setFont(&Cousine_Bold_16);
    // canvas.setFont(&Cousine_Bold_17);
    // canvas.setFont(&Cousine_Bold_18);
    canvas.setFont(&Cousine_Bold_19);
    // canvas.setFont(&Cousine_Bold_21);

    indent = 5;
    //  indent = 10;
    canvas.setCursor(indent, 18); // 18 is the base line of the font
    snprintf(timeBuffer, sizeof(timeBuffer), "%d/%02d/%02d", NOW.year(), NOW.month(), NOW.day());
    canvas.print(timeBuffer);

    // DOW -- Day of the week
    indent = 63 - (dayOfWeekLength * 6); //
                                         //  indent = 61 - (dayOfWeekLength * 5); // 6 is half the width of the font in pixels or close to it
    canvas.setCursor(indent, 36);        // 32 is the base line of the font
    canvas.print(dayOfWeek);             // Print the day of the week to the matrix

    // TIME 12Hr
    if (!Clock24hr)
    {
      if (Hour < 10)
        indent = 10; //  Left margin for 1 digit hour
      else
        indent = 5; //  Left margin for 2 digit hour
      canvas.setCursor(indent, 56);
      snprintf(timeBuffer, sizeof(timeBuffer), "%d:%02d:%02d%cM", Hour, NOW.minute(), NOW.second(), AMPM); // Format the time string
      canvas.print(timeBuffer);
    }
    else // TIME 24Hr
    {
      indent = 17; //  Left margin for 2 digit hour
      canvas.setCursor(indent, 56);
      snprintf(timeBuffer, sizeof(timeBuffer), "%02d:%02d:%02d", NOW.hour(), NOW.minute(), NOW.second()); // Format the time string
      canvas.print(timeBuffer);
    }
  }
  if (Font == 2)
  {
    canvas.setFont(&Orbitron_Bold_16);
    // canva.setFont(&Cousine_Regular_16);
    // canvas.setFont(0);
    // canvas.setFont(&Cousine_Bold_Italic_16);
    // canvas.setFont(&Cousine_Bold_16);
    // canvas.setFont(&Cousine_Bold_17);
    // canvas.setFont(&Cousine_Bold_18);
    // canvas.setFont(&Cousine_Bold_19);
    // canvas.setFont(&Cousine_Bold_21);

    indent = 5;
    //  indent = 10;
    canvas.setCursor(indent, 18); // 18 is the base line of the font
    canvas.print(timeBuffer);

    // DOW -- Day of the week
    indent = 63 - (dayOfWeekLength * 6); //
                                         //  indent = 61 - (dayOfWeekLength * 5); // 6 is half the width of the font in pixels or close to it
    canvas.setCursor(indent, 36);        // 32 is the base line of the font
    canvas.print(dayOfWeek);             // Print the day of the week to the matrix

    // TIME 12Hr
    
    {
      if (Hour < 10)
        indent = 17; //  Left margin for 1 digit hour
      else
        indent = 12; //  Left margin for 2 digit hour
      canvas.setCursor(indent, 56);
      snprintf(timeBuffer, sizeof(timeBuffer), "%d:%02d:%02d%cM", Hour, NOW.minute(), NOW.second(), AMPM); // Format the time string
      canvas.print(timeBuffer);
    }
    else // TIME 24Hr
    {
      indent = 15; //  Left margin for 2 digit hour
      canvas.setCursor(indent, 56);
      snprintf(timeBuffer, sizeof(timeBuffer), "%02d:%02d:%02d", NOW.hour(), NOW.minute(), NOW.second()); // Format the time string
      canvas.print(timeBuffer);
    }
  }
  ////////    after font cases
  matrix.drawRGBBitmap(0, 0, canvas.getBuffer(), canvas.width(), canvas.height()); // Clear the screen with the background color
  matrix.show();                                                                   // Copy data to matrix buffer

  return;

} // End Clock_Menu()

bool warmBootSetup()
{
  return true;
