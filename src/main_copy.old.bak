bool GNSSGet(u16_t milliWait, bool eventJob)
{

  u32_t end = millis() + milliWait;
  // u8_t gnsschar;
  if (eventJob)
  {
    EVENT_JOB_GNSS = setEvent(GNSSGetSetEvent, myTZ.now() + 600); // Set an event to retry the GNSS setup in 10 minutes
    if (EVENT_JOB_GNSS >= 1 && EVENT_JOB_GNSS <= 8)
    {
      debug("GNSS event ");
      debug(EVENT_JOB_GNSS);
      debugln(" running again in 10 minutes");
    }
    else
    {
      debugln("Failed to set GNSS");
    }
  }

  while (millis() < end)
  {

    gnss.checkUblox(); // See if new data is available. Process bytes as they come in.

    if (gnss.getLatitude() && gnss.getLongitude() && gnss.getAltitude() && gnss.getDateValid() && gnss.getTimeValid() && (gnss.getSIV() > 0))
    {
      gnssLat = gnss.getLatitude();     // Latitude
      gnssLong = gnss.getLongitude();   // Longitude
      gnssElev = gnss.getAltitude();    // Altitude
      gnssSiv = gnss.getSIV();          // Number of satellites in view
      gnssLat = gnssLat / 10000000.0;   // Convert to Degrees
      gnssLong = gnssLong / 10000000.0; // Convert to Degrees
      gnssElev = gnssElev / 1000.0;     // Convert to Meters
      gnssYear = gnss.getYear();        // Year
      gnssMonth = gnss.getMonth();      // Month
      gnssDay = gnss.getDay();          // Day
      gnssHour = gnss.getHour();        // Hour
      gnssMinute = gnss.getMinute();    // Minute
      gnssSecond = gnss.getSecond();    // Second
      gnssNow = DateTime(gnssYear, gnssMonth, gnssDay, gnssHour, gnssMinute, gnssSecond);
      UnixTime = gnssNow.unixtime(); // Get the current time in Unix format
      UnixTimeGnssOld = UnixTime;    // Save the old Unix time for comparison

      debugln("gnss date & time valid");

      debug("Satellites: ");
      debugln(gnssSiv);

      CBlock.Latitude = gnssLat;   // Save the latitude to the CBlock
      CBlock.Longitude = gnssLong; // Save the longitude to the CBlock
      CBlock.Elevation = gnssElev; // Save the altitude to the CBlock

      return true; // Set the GNSS status to true
    }
  }

  debugln("gnss location not valid");
  return false;

} // End GNSSGet()

void updateBlocks()
{
  fram.write(dControl.CBlockADDR, (u8_t *)&CBlock, sizeof(CBlock));       // Write the CBlock structure to FRAM
  fram.write(dControl.BBlockADDR, (u8_t *)&BBlock, sizeof(BBlock));       // Write the BBlock structure to FRAM
  fram.write(dControl.dControlADDR, (u8_t *)&dControl, sizeof(dControl)); // Write the dControl structure to FRAM
}

bool webServerSetup()
{
  ElegantOfTA.begin(&server);

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *request)
            { request->send(200, "text/plain", "This is Wunderclock!"); });

  server.begin(); // Start the web server

  return true; // Return true to indicate successful setup
} // End webServerSetup()

void tester_menu()
{
  u32_t end;
  // This function is used for testing purposes
  matrix.fillScreen(0);  // Clear the matrix display
  menuFlagToggle = true; // Set menuFlagToggle to true so we don't repeat the tester function
  end = millis() + 3000;

  displayImage("/JayR.bmp", 0, 0);                                                 // Display the Wunderclock logo
  matrix.drawRGBBitmap(0, 0, canvas.getBuffer(), canvas.width(), canvas.height()); // Clear the screen with the background color
  matrix.show();                                                                   // Show the updated data on the matrix display

  while (!IRrepeat && IRcommand != IROK)
  {
    IRMenu(2); // Call the IR menu function to handle IR commands
  }

  while (millis() < end)
  {
    IRMenu(2); // Call the IR menu function to handle IR commands
  }

  while (millis() < end + 6000)
  {
    // Do nothing for 15 seconds
    IRMenu(2); // Call the IR menu function to handle IR commands

    displayImage("/color.bmp", 0, 0);                                                // Display the test image
    matrix.drawRGBBitmap(0, 0, canvas.getBuffer(), canvas.width(), canvas.height()); // Clear the screen with the background color
    matrix.show();                                                                   // Show the updated data on the matrix display
  }
  while (millis() < end + 12000)
  {
    // Do nothing for 15 seconds
    IRMenu(2);                                                                       // Call the IR menu function to handle IR commands
    displayImage("/woman.bmp", 0, 0);                                                // Display the Wunderclock logo
    matrix.drawRGBBitmap(0, 0, canvas.getBuffer(), canvas.width(), canvas.height()); // Clear the screen with the background color
    matrix.show();                                                                   // Show the updated data on the matrix display
  }

  IRMenu(2); // Call the IR menu function to handle IR commands

  return;
} // End tester_menu()
