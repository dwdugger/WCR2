bool RTCSetup()
{
  // Check if RTC is valid if not set to compile time so we have valid time
  localT = RTClock.now();
  if (localT.isValid())
  {
    debugln("RTC is valid");
  }
  else
  {
    RTClock.adjust(DateTime(F(__DATE__), F(__TIME__))); // sets RTC to compile time
    debugln("RTC is NOT valid");
    localT = RTClock.now(); // set time now that we know RTC is valid
  }

  return true;
} // End RTCSetup()

void matrixErrorPrint(const char *text)
{
  matrix.fillScreen(0);
  matrix.setFont();
  matrix.setTextSize(1);
  matrix.setCursor(2, 16);
  matrix.print(text);
  matrix.show();
} // End matrixErrorPrint()

void matrixErrorPrintln(const char *text)
{
  matrix.fillScreen(0);
  matrix.setFont();
  matrix.setTextSize(1);
  matrix.setCursor(2, 16);
  matrix.println(text);
  matrix.show();
} // End matrixErrorPrintln()

bool GoogleMapsTZAPI()
{ // put google maps API code here to get timezone data from gnss location *****************************************************

  String URL = "https://maps.googleapis.com/maps/api/timezone/json?location=" + String(gnssLat) + "," + String(gnssLong) + "&timestamp=" + String(UnixTime.unixtime()) + "&key=" + KeyGoogleMapsAPI; // Google Maps API URL
  debugln(URL);                                                                                                                                                                                      // Print the URL to the serial monitor

  WiFiClientSecure client;
  HTTPClient http; // Create an HTTP client object

  http.useHTTP10(true); // Use HTTP/1.0 for the request
  client.setInsecure(); // Disable SSL certificate verification for testing purposes

  http.setTimeout(10000); // Set the timeout for the HTTP request to 10 seconds

  http.begin(client, URL); // Start the HTTP client with the URL

  int httpCode = http.GET(); // Send the HTTP GET request and get the response code

  if (WiFi.status() == WL_CONNECTED)
  {
    debugln("WiFi connectedTZAPI");
    debug("HTTP code: ");
    debugln(httpCode); // Print the HTTP response code to the serial monitor
  }
  else
  {
    debugln("WiFi not connected, NTP not set up, must set clock manually");
    return false;
  }

  // Parse JSON object
  DeserializationError error = deserializeJson(doc, http.getStream()); // Read the response and parse it as a JSON object
  if (error)
  {
    debug(F("deserializeJson() failed: "));
    debugln(error.f_str());
    client.stop(); // Stop the HTTP client
    http.end();    // End the HTTP client
    return false;
  }

  debugln("JSON parsed successfully");
  // Print the JSON object to the serial monitor
  dstOffset = doc["dstOffset"].as<int32_t>();      // Get the dstOffset value from the JSON object
  rawOffset = doc["rawOffset"].as<int32_t>();      // Get the rawOffset value from the JSON object
  timeZoneId = doc["timeZoneId"].as<String>();     // Get the timeZoneId value from the JSON object
  timeZoneName = doc["timeZoneName"].as<String>(); // Get the timeZoneName value from the JSON object

  debugln("Response:");
  debugln(doc["rawOffset"].as<int32_t>()); // Print the rawOffset value to the serial monitor
  debugln(doc["dstOffset"].as<int32_t>());
  debugln(doc["timeZoneId"].as<String>());

  client.stop(); // Stop the HTTP client
  http.end();    // End the HTTP client

  return true;
} // End GoogleMapsAPI()

