  // SPACE = length of a space between letters in milliseconds
  // CHAR_SPACE = length of a space between characters in milliseconds
  // WORD_SPACE = length of a space between words in milliseconds
  // WhatToKey = string to be printed in morse code
  // The string is converted to morse code and played using the buzzer
  // use '\' to escape for prosigns, beginning and end of prosign (e.g. \sk\ or \sos\)

  char workingChar;               // working character for morse code
  char tempChar;                  // temporary character for morse code
