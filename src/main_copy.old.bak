bool astroSetup()
{
  // Set up the Astro object
  myAstro.setLatLong(gnssLat, gnssLong); // Set the location of the observer
                                         // myAstro.setTimeZone(float(myTZ.getOffset() / -60.0)); // Set the timezone offset in hours
  debug("gnssLat: ");
  debugln(gnssLat);
  debug("gnssLong: ");
  debugln(gnssLong);
  debug("gnssElev: ");
  debugln(gnssElev);
  myAstro.setTimeZone(rawOffset / 3600); // Set the timezone offset in hours
  myAstro.setElevationM(gnssElev);       // Set the elevation of the observer in meters
  if (myTZ.isDST() || dstOffset != 0)
  {
    myAstro.setDST(); // Set DST to true
  }
  else
  {
    myAstro.rejectDST(); // Set DST to false
  }
  if (!status_GNSSGet && status_NTPSetup)
  {
    myAstro.setGMTdate(UTC.year(), UTC.month(), UTC.day()); // Set the local date in seconds since epoch
    debugln("Setting local time from NTP");
    debugln("UTC: " + UTC.dateTime());                               // Print the UTC date and time to the serial monitor
    myAstro.setLocalTime(myTZ.hour(), myTZ.minute(), myTZ.second()); // Set the local time in seconds since epoch
    debugln(myAstro.getLT());
  }
  else
  {
    myAstro.setGMTdate(gnssYear, gnssMonth, gnssDay); // Set the date in GMT
    debugln("Setting GMT time from GNSS");
    myAstro.setGMTtime(gnssHour, gnssMinute, gnssSecond); // Set the time in GMT
  }
  astroGet(); // Get the sun and moon positions and rise/set times

  return true;
} // End astroSetup()

bool astroGet()
{

  double myAstroTMP;

  myAstro.doMoon();                                                                // Calculate the moon position
  myAstro.doMoonRiseSetTimes();                                                    // Calculate the moon rise and set times
  myAstroTMP = myAstro.getMoonriseTime() * 3600.0;                                 // Calculate the moon rise time in seconds
  MoonriseTime = DateTime(year(), month(), day(), 0, 0, 0) + TimeSpan(myAstroTMP); // Set the moon rise time to the current date
  debugln(myAstroTMP);
  myAstroTMP = myAstro.getMoonsetTime() * 3600.0;                                 // Calculate the moon set time
  MoonsetTime = DateTime(year(), month(), day(), 0, 0, 0) + TimeSpan(myAstroTMP); // Set the moon set time to the current date

  myAstro.doSun();                                                                // Calculate the sun position
  myAstro.doSunRiseSetTimes();                                                    // Calculate the sun rise and set times
  myAstroTMP = myAstro.getSunriseTime() * 3600.0;                                 // Calculate the sun rise time
  SunriseTime = DateTime(year(), month(), day(), 0, 0, 0) + TimeSpan(myAstroTMP); // Set the sun rise time to the current date
  myAstroTMP = myAstro.getSunsetTime() * 3600.0;                                  // Calculate the sun set time
  SunsetTime = DateTime(year(), month(), day(), 0, 0, 0) + TimeSpan(myAstroTMP);  // Set the sun set time to the current date

  // Get the moon phase
  myAstro.getMoonPhase(); // Get the moon phase

  return true;
} // End astroGet()

void astroData_Menu()
