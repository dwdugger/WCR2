void setupClock_Sub(u8_t passLevel)
{
  menuLevel = passLevel;

  if (!menuTempFlag2)
  {
    matrix.fillScreen(0);
    matrix.setFont(0);
    matrix.setTextSize(1);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.setCursor(2, 0);
    if (activeSubMenuElement == 0)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Date/Time");
    matrix.setCursor(2, 8);
    if (activeSubMenuElement == 1)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("GMT Offset");
    matrix.setCursor(2, 16);
    if (activeSubMenuElement == 2)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("DST/Summer");
    matrix.setCursor(2, 24);
    if (activeSubMenuElement == 3)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Back");

    matrix.setCursor(2, 40);
    matrix.setTextColor(CYAN, BLACK);
    matrix.print("Use U/D to");
    matrix.setCursor(2, 48);
    matrix.print("select");
    matrix.setCursor(2, 56);
    matrix.print("OK = enter");
    matrix.setTextColor(MYYELLOW2, BLACK);
  }

  /******************************************************************************************************/

  if (menuTempFlag2)
  {

    switch (activeSubMenuElement)
    {
    case 0:
      setupDateTime_Sub(menuLevel); // Date and time setup
      break;
    case 1:
      setupGMToffset_Sub(menuLevel); // GMT offset setup
      break;
    case 2:
      setupDST_Sub(menuLevel); // DST/Summer time setup
      break;
    case 3:
      menuTempFlag1 = false;
      menuTempFlag2 = false;
      activeSubMenuElement = 0;
      activeMenuElement = 1;
      menuLocation = 0;
      IRcommand = 0;             // Clear the IR command after processing
      GMToffset = Set_GMToffset; // Set the GMT offset to the new value
      if (Set_DST)
        dstOffset = 3600;
      else
        dstOffset = 0;
      RTClock.adjust(DateTime(Set_Year, Set_Month, Set_Day, Set_Hour, Set_Minute, 0)); // Set the RTC to the new time
      menuLevel = 0;
      return; // Go back to previous menu
      break;
    default:
      // should not get here
      break;
    }
  }

  if (menuLevel == 1)
  {
    if (!IRrepeat && IRcommand == IROK)
    {
      menuTempFlag2 = true; // OK button
      menuLevel = 2;
    }

    if (!IRrepeat && IRcommand == IRU)
    {
      if (activeSubMenuElement == 0)
        activeSubMenuElement = 3;
      else
        activeSubMenuElement = (activeSubMenuElement - 1) % 4; // Up button
    }
    if (!IRrepeat && IRcommand == IRD)
      activeSubMenuElement = (activeSubMenuElement + 1) % 4; // Down button

    matrix.show();
  }

} // End setupClock_Sub()

void exit_Sub()
{

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 16);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Save Y/N");
    matrix.setCursor(90, 32);

    if (!IRrepeat && IRcommand == IRU)
      Set_Save = !Set_Save;
    if (!IRrepeat && IRcommand == IRD)
      Set_Save = !Set_Save;
    matrix.setTextColor(MYYELLOW2, BLUE);

    if (Set_Save)
    {
      matrix.print("Y");
    }
    else
    {
      matrix.print("N");
    }

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
      break; // Exit the loop if OK button is pressed
  }

  if (Set_Save)
  {
    CBlock.Elevation = Set_Elevation;           // Set the elevation to the new value
    CBlock.Latitude = Set_Latitude;             // Set the latitude to the new value
    CBlock.Longitude = Set_Longitude;           // Set the longitude to the new value
    CBlock.GMToffset = Set_GMToffset;           // Set the GMT offset to the new value
    CBlock.DST = Set_DST;                       // Set the DST/Summer time to the new value
    CBlock.menuRotateTime = Set_MenuRotateTime; // Set the menu rotate time to the new value
    for (u8_t i = 0; i < 10; i++)
      CBlock.menuRotateArray[i] = Set_MenuRotateArray[i]; // Set the menu rotate array to the new value
    CBlock.menuRotate = Set_MenuRotateYN;                 // Set the menu rotate flag to the new value
  }

  menuTempFlag1 = false;
  menuTempFlag2 = false;
  activeSubMenuElement = 0;
  activeMenuElement = 0;
  menuLocation = 0;
  IRcommand = 0; // Clear the IR command after processing
  menuLevel = 0;
  BBlock.bootMode = 0;    // Set the boot mode to normal
  CBlock.ProgramMode = 1; // Set the program mode to normal

  // Update all CBlock values here before exiting the menu
  updateBlocks(); // Update the BBlock structure in FRAM
  // controledRestart(); // Restart the ESP32
} // End exit_Sub()

void setupDateTime_Sub(u8_t passLevel)
{
  menuLevel = passLevel;
  u16_t tempYear = 0;
  u8_t tempMonth = 0;
  u8_t tempDay = 0;
  u8_t tempHour = 0;
  u8_t tempMinute = 0;

  // Format is YYYY/MM/DD HH:MM

  tempYear = localT.year();
  tempMonth = localT.month();
  tempDay = localT.day();
  tempHour = localT.hour();
  tempMinute = localT.minute();

  Set_Year = tempYear;
  Set_Month = tempMonth;
  Set_Day = tempDay;
  Set_Hour = tempHour;
  Set_Minute = tempMinute;

  matrix.fillRect(0, 40, 63, 63, BLACK); // Clear the left side of the screen
  matrix.setCursor(2, 40);
  matrix.setTextColor(CYAN, BLACK);
  matrix.print("Press/Hold");
  matrix.setCursor(2, 48);
  matrix.print("UD/LR=set");
  matrix.setCursor(2, 56);
  matrix.print("OK = save");
  matrix.setTextColor(MYYELLOW2, BLACK);

  char timeBuffer[5]; // Holds formatted time string

  u8_t DPM[12] = {31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}; // Days per month

  IRcommand = 0; // Clear the IR command before entering the loop

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    if ((Set_Year % 4 == 0) && !(Set_Year % 400 == 0))
      DPM[1] = 29;
    else
      DPM[1] = 28; // Adjust for leap year

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 0);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("YYYY/MM/DD");
    matrix.setCursor(66, 16);

    if (menuLocation == 0)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU)) // Up button
        Set_Year++;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD)) // Down button
        Set_Year--;
      if (Set_Year > 2099)
        Set_Year = 2025;
      if (Set_Year < 2025)
        Set_Year = 2099;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(Set_Year);

    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("/");

    if (menuLocation == 1)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        Set_Month++;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        Set_Month--;
      if (Set_Month == 0)
        Set_Month = 12;
      if (Set_Month == 13)
        Set_Month = 1;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }

    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    snprintf(timeBuffer, sizeof(timeBuffer), "%02d", Set_Month);
    matrix.print(timeBuffer);
    memset(timeBuffer, 0, sizeof(timeBuffer)); // Clear the time buffer

    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("/");

    if (menuLocation == 2)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        Set_Day++;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        Set_Day--;
      if (Set_Day == 0)
        Set_Day = DPM[Set_Month - 1];
      if (Set_Day == DPM[Set_Month - 1] + 1)
        Set_Day = 1;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }

    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    snprintf(timeBuffer, sizeof(timeBuffer), "%02d", Set_Day);
    matrix.print(timeBuffer);
    memset(timeBuffer, 0, sizeof(timeBuffer)); // Clear the time buffer

    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.setCursor(80, 32);
    matrix.print("HH:MM");
    matrix.setCursor(80, 48);

    if (menuLocation == 3)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        Set_Hour++;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        Set_Hour--;
      if (Set_Hour == 255)
        Set_Hour = 23;
      if (Set_Hour == 24)
        Set_Hour = 0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    snprintf(timeBuffer, sizeof(timeBuffer), "%02d", Set_Hour);
    matrix.print(timeBuffer);
    memset(timeBuffer, 0, sizeof(timeBuffer)); // Clear the time buffer

    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(":");

    if (menuLocation == 4)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        Set_Minute++;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        Set_Minute--;
      if (Set_Minute == 255)
        Set_Minute = 59;
      if (Set_Minute == 60)
        Set_Minute = 0;

      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    snprintf(timeBuffer, sizeof(timeBuffer), "%02d", Set_Minute);
    matrix.print(timeBuffer);
    memset(timeBuffer, 0, sizeof(timeBuffer)); // Clear the time buffer

    matrix.setTextColor(MYYELLOW2, BLACK);

    if (!IRrepeat && IRcommand == IRR)
      menuLocation = (menuLocation + 1) % 5; // Right button

    if (!IRrepeat && IRcommand == IRL)
    {
      if (menuLocation == 0)
        menuLocation = 4;
      else
        menuLocation = (menuLocation - 1) % 5; // Left button
    }
    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  }
  // Now we have the new time values, set the RTC
  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 0;
  activeMenuElement = 1;
  // menuTempFlag1 = false;
  menuLocation = 0;

} // End setupDateTime_Sub()

void setupGMToffset_Sub(u8_t passLevel)
{
  menuLevel = passLevel;
  IRcommand = 0; // Clear the IR command before entering the loop
  float GMTfraction;

  matrix.fillRect(0, 40, 63, 63, BLACK); // Clear the left side of the screen
  matrix.setCursor(2, 40);
  matrix.setTextColor(CYAN, BLACK);
  matrix.print("Press/Hold");
  matrix.setCursor(2, 48);
  matrix.print("U/D to set");
  matrix.setCursor(2, 56);
  matrix.print("OK = enter");
  matrix.setTextColor(MYYELLOW2, BLACK);

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 16);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("GMT offset ");
    matrix.setCursor(82, 32);

    if (!IRrepeat && IRcommand == IRU || IRrepeat && IRcommand == IRU)
      Set_GMToffset = Set_GMToffset + 0.25;

    if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
      Set_GMToffset = Set_GMToffset - 0.25;

    matrix.setTextColor(MYYELLOW2, BLUE);

    if (Set_GMToffset > 14)
      Set_GMToffset = -12;
    if (Set_GMToffset < -12)
      Set_GMToffset = 14;

    GMTfraction = Set_GMToffset - (int)Set_GMToffset;
    GMTfraction = fabs(GMTfraction);

    matrix.print((int)Set_GMToffset);
    matrix.print(":");

    if (GMTfraction == 0.25)
      matrix.print("15");
    else if (GMTfraction == 0.50)
      matrix.print("30");
    else if (GMTfraction == 0.75)
      matrix.print("45");
    else
      matrix.print("00");

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  }
  // DST setting is in Set_DST

  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 1;
  activeMenuElement = 1;
  menuLocation = 0;

} // End setupGMToffset_Sub()

void setupDST_Sub(u8_t passLevel)
{

  menuLevel = passLevel;
  IRcommand = 0; // Clear the IR command before entering the loop

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 16);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("DST/Summer");
    matrix.setCursor(90, 32);

    if (!IRrepeat && IRcommand == IRU)
      Set_DST = !Set_DST;
    if (!IRrepeat && IRcommand == IRD)
      Set_DST = !Set_DST;
    matrix.setTextColor(MYYELLOW2, BLUE);

    if (Set_DST)
    {
      matrix.print("Y");
    }
    else
    {
      matrix.print("N");
    }

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  }
  // DST setting is in Set_DST

  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 2;
  activeMenuElement = 1;
  menuLocation = 0;

} // End setupDST_Sub()

void setupLocation_Sub(u8_t passLevel)
{
  menuLevel = passLevel;

  if (!menuTempFlag2)
  {
    matrix.fillScreen(0);
    matrix.setFont(0);
    matrix.setTextSize(1);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.setCursor(2, 0);
    if (activeSubMenuElement == 0)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Geo Cords");
    matrix.setCursor(2, 8);
    if (activeSubMenuElement == 1)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Back");

    matrix.setCursor(2, 40);
    matrix.setTextColor(CYAN, BLACK);
    matrix.print("Use U/D to");
    matrix.setCursor(2, 48);
    matrix.print("select");
    matrix.setCursor(2, 56);
    matrix.print("OK = enter");
    matrix.setTextColor(MYYELLOW2, BLACK);
  }

  /******************************************************************************************************/

  if (menuTempFlag2)
  {

    switch (activeSubMenuElement)
    {
    case 0:
      setupLatLong_Sub(menuLevel); // Date and time setup
      break;
    case 1:
      menuTempFlag1 = false;
      menuTempFlag2 = false;
      activeSubMenuElement = 0;
      activeMenuElement = 2;
      menuLocation = 0;
      IRcommand = 0; // Clear the IR command after processing

      menuLevel = 0;
      return; // Go back to previous menu
      break;
    default:
      // should not get here
      break;
    }
  }

  if (menuLevel == 1)
  {
    if (!IRrepeat && IRcommand == IROK)
    {
      menuTempFlag2 = true; // OK button
      menuLevel = 2;
    }

    if (!IRrepeat && IRcommand == IRU)
    {
      if (activeSubMenuElement == 0)
        activeSubMenuElement = 1;
      else
        activeSubMenuElement = (activeSubMenuElement - 1) % 2; // Up button
    }
    if (!IRrepeat && IRcommand == IRD)
      activeSubMenuElement = (activeSubMenuElement + 1) % 2; // Down button

    matrix.show();
  }
} // End setupLocation_Sub()

void setupLatLong_Sub(u8_t passLevel)
{
  menuLevel = passLevel;

  float tempLat = 0.0;
  float tempLong = 0.0;
  s16_t tempElev = 0;
  bool tempIsEast = true;
  bool tempIsNorth = true;
  u16_t tempLatInt = 0;
  u16_t tempLatFrac = 0;
  u16_t tempLongInt = 0;
  u16_t tempLongFrac = 0;

  tempLat = CBlock.Latitude;
  tempLong = CBlock.Longitude;
  tempElev = (int)CBlock.Elevation;

  Set_Latitude = tempLat;
  Set_Longitude = tempLong;
  Set_Elevation = tempElev;

  if (tempLat < 0)
    tempIsNorth = false;
  if (tempLong < 0)
    tempIsEast = false;

  char latBuffer[7];  // Holds formatted latitude string
  char longBuffer[8]; // Holds formatted longitude string
  char elevBuffer[7]; // Holds formatted elevation string

  IRcommand = 0; // Clear the IR command before entering the loop

  while (true)
  {
    memset(latBuffer, 0, sizeof(latBuffer));   // Clear the latitude buffer
    memset(longBuffer, 0, sizeof(longBuffer)); // Clear the longitude buffer
    memset(elevBuffer, 0, sizeof(elevBuffer)); // Clear the elevation buffer

    tempLat = fabs(tempLat);
    tempLong = fabs(tempLong);

    tempLatInt = (int)tempLat;
    tempLatFrac = (int)((tempLat - tempLatInt) * 1000);
    tempLongInt = (int)tempLong;
    tempLongFrac = (int)((tempLong - tempLongInt) * 1000);

    if (tempLat != 0)
    {
      snprintf(latBuffer, sizeof(latBuffer), "%02d.%03d", tempLatInt, tempLatFrac); // Convert latitude to string
    }
    else
      strcpy(latBuffer, "00.000");

    if (tempLong != 0)
      snprintf(longBuffer, sizeof(longBuffer), "%03d.%03d", tempLongInt, tempLongFrac); // Convert longitude to string
    else
      strcpy(longBuffer, "000.000");

    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 127, 63, BLACK); // Clear the right side of the screen

    matrix.fillRect(0, 40, 63, 63, BLACK); // Clear the left side of the screen
    matrix.setCursor(2, 40);
    matrix.setTextColor(CYAN, BLACK);
    matrix.print("Press/Hold");
    matrix.setCursor(2, 48);
    matrix.print("UD/LR=set");
    matrix.setCursor(2, 56);
    matrix.print("OK = enter");
    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.setCursor(66, 0);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Lat");

    matrix.setCursor(75, 10);

    if (menuLocation == 0)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLat = tempLat + 10.0;
      if (!IRrepeat && IRcommand == IRD)
        tempLat = tempLat - 10.0;
      if (tempLat > 90.0)
        tempLat = 0.0;
      if (tempLat < 0)
        tempLat = 90.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(latBuffer[0]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 1)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        tempLat = tempLat + 1.0;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        tempLat = tempLat - 1.0;
      if (tempLat > 90.0)
        tempLat = 0.0;
      if (tempLat < 0)
        tempLat = 90.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(latBuffer[1]);

    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(latBuffer[2]); // This is the decimal point "."

    if (menuLocation == 2)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLat = tempLat + 0.1;
      if (!IRrepeat && IRcommand == IRD)
        tempLat = tempLat - 0.1;
      if (tempLat > 90.0)
        tempLat = 0.0;
      if (tempLat < 0)
        tempLat = 90.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(latBuffer[3]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 3)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLat = tempLat + 0.01;
      if (!IRrepeat && IRcommand == IRD)
        tempLat = tempLat - 0.01;
      if (tempLat > 90.0)
        tempLat = 0.0;
      if (tempLat < 0)
        tempLat = 90.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(latBuffer[4]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 4)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        tempLat = tempLat + 0.001;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        tempLat = tempLat - 0.001;
      if (tempLat > 90.0)
        tempLat = 0.0;
      if (tempLat < 0)
        tempLat = 90.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(latBuffer[5]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 5)
    {
      matrix.setTextColor(MYYELLOW2, BLUE);

      if ((!IRrepeat && IRcommand == IRU) || (!IRrepeat && IRcommand == IRD))
        tempIsNorth = !tempIsNorth; // Toggle North/South on Up or Down button
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    if (tempIsNorth && tempLat != 0)
      matrix.print("N");
    else if (!tempIsNorth && tempLat != 0)
      matrix.print("S");
    else if (tempLat == 0)
    {
      tempIsNorth = true;
      matrix.print(" ");
    }

    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.setCursor(66, 20);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Long");
    matrix.setCursor(75, 30);

    if (menuLocation == 6)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLong = tempLong + 100.0;
      if (!IRrepeat && IRcommand == IRD)
        tempLong = tempLong - 100.0;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[0]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 7)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLong = tempLong + 10.0;
      if (!IRrepeat && IRcommand == IRD)
        tempLong = tempLong - 10.0;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[1]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 8)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        tempLong = tempLong + 1.0;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        tempLong = tempLong - 1.0;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[2]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[3]); // This is the decimal point "."

    if (menuLocation == 9)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLong = tempLong + 0.1;
      if (!IRrepeat && IRcommand == IRD)
        tempLong = tempLong - 0.1;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[4]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 10)
    {
      if (!IRrepeat && IRcommand == IRU)
        tempLong = tempLong + 0.01;
      if (!IRrepeat && IRcommand == IRD)
        tempLong = tempLong - 0.01;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[5]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 11)
    {
      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        tempLong = tempLong + 0.001;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        tempLong = tempLong - 0.001;
      if (tempLong > 180.0)
        tempLong = 0.0;
      if (tempLong < 0)
        tempLong = 180.0;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(longBuffer[6]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (menuLocation == 12)
    {
      matrix.setTextColor(MYYELLOW2, BLUE);

      if ((!IRrepeat && IRcommand == IRU) || (!IRrepeat && IRcommand == IRD))
        tempIsEast = !tempIsEast; // Toggle East/West on Up or Down button
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    if (tempIsEast && tempLong != 0)
      matrix.print("E");
    else if (!tempIsEast && tempLong != 0)
      matrix.print("W");
    else if (tempLong == 0)
    {
      tempIsEast = true;
      matrix.print(" ");
    }
    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.setCursor(66, 40);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Elev ");
    matrix.setCursor(75, 50);

    if (menuLocation == 13)
    {

      matrix.fillRect(0, 40, 63, 63, BLACK); // Clear the left side of the screen
      matrix.setCursor(2, 40);
      matrix.setTextColor(CYAN, BLACK);
      matrix.print("Press/Hold");
      matrix.setCursor(2, 48);
      matrix.print("*#=UD x 1K");
      matrix.setCursor(2, 56);
      matrix.print("OK = save");
      matrix.setTextColor(MYYELLOW2, BLACK);
      matrix.setCursor(75, 50);

      if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
        tempElev = tempElev + 1;
      if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
        tempElev = tempElev - 1;
      if ((!IRrepeat && IRcommand == IRS) || (IRrepeat && IRcommand == IRS))
        tempElev = tempElev + 1000;
      if ((!IRrepeat && IRcommand == IRP) || (IRrepeat && IRcommand == IRP))
        tempElev = tempElev - 1000;

      if (tempElev > 32767)
        tempElev = -32767;
      if (tempElev < -32767)
        tempElev = 32767;
      matrix.setTextColor(MYYELLOW2, BLUE);
    }
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(tempElev);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("m");

    // after all menu locations

    if (!IRrepeat && IRcommand == IRR)
      menuLocation = (menuLocation + 1) % 14; // Right button

    if (!IRrepeat && IRcommand == IRL)
    {
      if (menuLocation == 0)
        menuLocation = 13;
      else
        menuLocation = (menuLocation - 1) % 14; // Left button
    }

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      Set_Elevation = tempElev;
      if (!tempIsNorth)
        Set_Latitude = -fabs(tempLat);
      else
        Set_Latitude = fabs(tempLat);
      if (!tempIsEast)
        Set_Longitude = -fabs(tempLong);
      else
        Set_Longitude = fabs(tempLong);
      break; // Exit the loop if OK button is pressed
    }
  }

  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 0;
  activeMenuElement = 2;
  menuLocation = 0;

} // End setupLatLong_Sub()

void setupMenuRotate_Sub(u8_t passLevel)
{
  menuLevel = passLevel;

  if (!menuTempFlag2)
  {
    matrix.fillScreen(0);
    matrix.setFont(0);
    matrix.setTextSize(1);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.setCursor(2, 0);
    if (activeSubMenuElement == 0)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Rotate Y/N");
    matrix.setCursor(2, 8);
    if (activeSubMenuElement == 1)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Hold Time");
    matrix.setCursor(2, 16);
    if (activeSubMenuElement == 2)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Edit Order");
    matrix.setCursor(2, 24);
    if (activeSubMenuElement == 3)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Back");

    matrix.setCursor(2, 40);
    matrix.setTextColor(CYAN, BLACK);
    matrix.print("Use U/D to");
    matrix.setCursor(2, 48);
    matrix.print("select");
    matrix.setCursor(2, 56);
    matrix.print("OK = enter");
    matrix.setTextColor(MYYELLOW2, BLACK);
  }

  /******************************************************************************************************/

  if (menuTempFlag2)
  {

    switch (activeSubMenuElement)
    {
    case 0:
      setupMenuRotateBool_Sub(menuLevel); // Enable/disable menu rotate
      break;
    case 1:
      setupMenuRotateTime_Sub(menuLevel); // Menu rotate time
      break;
    case 2:
      setupMenuRotateOrder_Sub(menuLevel); // Menu rotate order
      break;
    case 3:
      menuTempFlag1 = false;
      menuTempFlag2 = false;
      activeSubMenuElement = 0;
      activeMenuElement = 3;
      menuLocation = 0;
      IRcommand = 0; // Clear the IR command after processing
      menuLevel = 0;
      return; // Go back to previous menu
    }
  }
  if (menuLevel == 1)
  {
    if (!IRrepeat && IRcommand == IROK)
    {
      menuTempFlag2 = true; // OK button
      menuLevel = 2;
    }

    if (!IRrepeat && IRcommand == IRU)
    {
      if (activeSubMenuElement == 0)
        activeSubMenuElement = 1;
      else
        activeSubMenuElement = (activeSubMenuElement - 1) % 4; // Up button
    }
    if (!IRrepeat && IRcommand == IRD)
      activeSubMenuElement = (activeSubMenuElement + 1) % 4; // Down button

    matrix.show();
  }
} // End setupMenuRotate_Sub()

void setupMenuRotateBool_Sub(u8_t passLevel)
{
  menuLevel = passLevel;
  IRcommand = 0; // Clear the IR command before entering the loop

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 16);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("Rotate Y/N");
    matrix.setCursor(90, 32);

    if (!IRrepeat && IRcommand == IRU)
      Set_MenuRotateYN = !Set_MenuRotateYN;
    if (!IRrepeat && IRcommand == IRD)
      Set_MenuRotateYN = !Set_MenuRotateYN;
    matrix.setTextColor(MYYELLOW2, BLUE);

    if (Set_MenuRotateYN)
    {
      matrix.print("Y");
    }
    else
    {
      matrix.print("N");
    }

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  }

  IRcommand = 0; // Clear the IR command after processing
  // menuTempFlag1 = false;
  menuTempFlag2 = false;
  activeSubMenuElement = 0;
  activeMenuElement = 3;
  menuLocation = 0;
} // End setupMenuRotateBool_Sub()

void setupMenuRotateTime_Sub(u8_t passLevel)
{
  menuLevel = passLevel;
  IRcommand = 0; // Clear the IR command before entering the loop

  matrix.fillRect(0, 40, 63, 63, BLACK); // Clear the left side of the screen
  matrix.setCursor(2, 40);
  matrix.setTextColor(CYAN, BLACK);
  matrix.print("Press/Hold");
  matrix.setCursor(2, 48);
  matrix.print("*#=UD x 1K");
  matrix.setCursor(2, 56);
  matrix.print("OK = save");
  matrix.setTextColor(MYYELLOW2, BLACK);
  matrix.setCursor(75, 50);

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
    matrix.setCursor(66, 8);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print("hold Time");
    matrix.setCursor(66, 16);
    matrix.print("30s-3200s");
    matrix.setCursor(90, 32);

    matrix.setTextColor(MYYELLOW2, BLUE);

    if ((!IRrepeat && IRcommand == IRU) || (IRrepeat && IRcommand == IRU))
      Set_MenuRotateTime = Set_MenuRotateTime + 10;

    if ((!IRrepeat && IRcommand == IRD) || (IRrepeat && IRcommand == IRD))
      Set_MenuRotateTime = Set_MenuRotateTime - 10;
    if ((!IRrepeat && IRcommand == IRS) || (IRrepeat && IRcommand == IRS))
      Set_MenuRotateTime = Set_MenuRotateTime + 1000;
    if ((!IRrepeat && IRcommand == IRP) || (IRrepeat && IRcommand == IRP))
      Set_MenuRotateTime = Set_MenuRotateTime - 1000;

    Set_MenuRotateTime = constrain(Set_MenuRotateTime, 30, 3200);
    matrix.print(Set_MenuRotateTime);
    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  }

  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 1;
  activeMenuElement = 3;
  menuLocation = 0;
  return;

} // End setupMenuRotateTime_Sub()

void setupMenuRotateOrder_Sub(u8_t passLevel)
{
  menuLevel = passLevel;
  IRcommand = 0; // Clear the IR command before entering the loop

  matrix.fillRect(64, 0, 128, 64, BLACK); // Clear the right side of the screen
  matrix.setCursor(81, 0);
  matrix.setTextColor(MYYELLOW2, BLACK);
  matrix.print("Rotate");
  matrix.setCursor(84, 8);
  matrix.print("Order");

  while (true)
  {
    IRcommand = 0; // Clear the IR command at the start of each loop iteration

    IRLoop(); // Keep checking for IR commands

    IRMenu(2); // Call the IR menu function to handle IR commands

    matrix.setCursor(69, 21);
    matrix.print("0,1,2,3,4");
    matrix.setCursor(69, 32);

    if (menuLocation == 0)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(Set_MenuRotateArray[0]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 1)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[1]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 2)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[2]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 3)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[3]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 4)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(Set_MenuRotateArray[4]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.setCursor(69, 43);
    matrix.print("5,6,7,8,9");
    matrix.setCursor(69, 54);

    if (menuLocation == 5)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(Set_MenuRotateArray[5]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 6)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[6]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 7)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);

    matrix.print(Set_MenuRotateArray[7]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 8)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[8]);
    matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(",");

    if (menuLocation == 9)
      matrix.setTextColor(MYYELLOW2, BLUE);
    else
      matrix.setTextColor(MYYELLOW2, BLACK);
    matrix.print(Set_MenuRotateArray[9]);
    matrix.setTextColor(MYYELLOW2, BLACK);

    if (!IRrepeat && IRcommand == IRU)
      Set_MenuRotateArray[menuLocation] = (Set_MenuRotateArray[menuLocation] + 1) % 10;
    if (!IRrepeat && IRcommand == IRD)
      Set_MenuRotateArray[menuLocation] = (Set_MenuRotateArray[menuLocation] + 9) % 10;

    if (!IRrepeat && IRcommand == IRR)
      menuLocation = (menuLocation + 1) % 10; // Right button
    if (!IRrepeat && IRcommand == IRL)
      menuLocation = (menuLocation + 9) % 10; // Left button

    matrix.show();

    if (!IRrepeat && IRcommand == IROK)
    {
      menuLevel = 1;
      break; // Exit the loop if OK button is pressed
    }
  } // End while

  bool allUsed = true;
  for (u8_t i = 0; i < 10; i++)
  {
    if (Set_MenuRotateArray[i] == 0)
      allUsed = false;
    if (!allUsed) // if there is a zero in the array, set rest to zero
      Set_MenuRotateArray[i] = 0;
    debug(Set_MenuRotateArray[i]);
  }

  Set_MenuRotateArray[10] = 0; // Clear the last element just in case

  IRcommand = 0; // Clear the IR command after processing
  menuTempFlag2 = false;
  activeSubMenuElement = 2;
  activeMenuElement = 3;
  menuLocation = 0;
  return;

} // End setupMenuRotateOrder_Sub()

void owocWeatherGet()
{

  EVENT_JOB_WEATHER = setEvent(owocWeatherGet, myTZ.now() + 600);

  status_owocParseWeather = owocParseWeather();
  if (status_owocParseWeather)

    if (EVENT_JOB_WEATHER >= 1 && EVENT_JOB_WEATHER <= 8)
    {
      debug("WeatherGet event ");
      debug(EVENT_JOB_WEATHER);
      debugln(" running again in 10 minutes");
    }
    else
    {
      debugln("Failed to set WeatherGet event");
    }
} // End owocWeatherGet()

bool owocParseWeather()
{

  /*****************************************************************************************
   * Open Weather Setup
   * This is the Open Weather API setup. It will get the weather data from Open Weather API.
   * Boat load of setup and returned data.
   *****************************************************************************************/

  debugln("owocParseWeather called");

  if (BBlock.bootMode <= 1)
    owoc.parseWeather();

  debugln("OpenWeatherOneCall object parsed");

  // Verify all other values exist before using

  if (owoc.current) // Check if data is in the struct for all variables before using them
  {
    WBlock.dayTime = owoc.current->dayTime;
    WBlock.temp = owoc.current->temperature;
    WBlock.feelsLike = owoc.current->apparentTemperature;
    WBlock.windSpeed = owoc.current->windSpeed;
    WBlock.windBearing = owoc.current->windBearing;
    WBlock.humidity = owoc.current->humidity;
    WBlock.pressure = owoc.current->pressure;
    debugln("dayTime");
    debugln(WBlock.dayTime);
    debugln("temp");
    debugln(WBlock.temp);
    debugln("feelsLike");
    debugln(WBlock.feelsLike);
    debugln("windSpeed");
    debugln(WBlock.windSpeed);
    debugln("windBearing");
    debugln(WBlock.windBearing);
    debugln("humidity");
    debugln(WBlock.humidity);
    debugln("pressure");
    debugln(WBlock.pressure);
  }
  else
    debugln("CURRENT IS OFF or EMPTY");

  // Forecast is part of CURRENT and has info for the 8 days future weather. See variables PDF
  //  The JSON holds this info in the DAILY section and EXCL_D turns this off
  if (owoc.forecast)
  { // Check if data is in the struct for all variables before using them
    WBlock.pop = owoc.forecast[0].pop;
    WBlock.windGust = owoc.forecast[0].windGust;
    debugln("pop");
    debugln(WBlock.pop);
    debugln("windGust");
    debugln(WBlock.windGust);
  }
  else
    debugln("FORECAST IS OFF or EMPTY");

  /*
  { // Check if data is in the struct for all variables before using them
    Serial.printf("\nFORECAST - Up to 8 days future forecast\n");
    for (int x = 0; x < 8; x++)
    {
      Serial.printf("Date: %s High Temperature: % .0f\n", owoc.forecast[x].readableDateTime, owoc.forecast[x].temperatureHigh);
    }
  }
  else
    Serial.printf("\nFORECAST IS OFF or EMPTY\n");

  // Hour is part of CURRENT and has info for 48 hours future weather. See variables PDF
  //  The JSON holds this info in the HOURLY section and EXCL_H turns this off
  if (owoc.hour)
  { // Check if data is in the struct for all variables before using them
    Serial.printf("\nHOURLY   - Up to 48 hours forecast\n");

    for (int x = 0; x < 6; x++)
    {
      Serial.printf("%s Actual Temp: % .0f\n", owoc.hour[x].readableTime, owoc.hour[x].temperature);
      Serial.printf("%s Feels Like Temp: % .0f\n", owoc.hour[x].readableTime, owoc.hour[x].apparentTemperature);
    }
  }
  else
    Serial.printf("\nHOURLY IS OFF or EMPTY\n");

  // MINUTELY is part of CURRENT and has info for 60 minutes future weather. See variables PDF
  //  The JSON holds this info in the MINUTELY section and EXCL_M turns this off
  if (owoc.minute)
  { // Check if data is in the struct for all variables before using them
    Serial.printf("\nMINUTELY   - Up to 60 minutes precipitation forecast\n");

    for (int x = 0; x < 30; x++)
    {
      Serial.printf("%s Precipitation: % .2f\n", owoc.minute[x].readableTime, owoc.minute[x].precipitation);
    }
  }
  else
    Serial.printf("\nHOURLY IS OFF or EMPTY\n");

  // ALERTS is part of CURRENT and has info for alerts in your area. See variables PDF
  //  The JSON holds this info in the ALERTS section and EXCL_A turns this off
  if (owoc.alert) // Check if data is in the struct for all variables before using them
  {
    Serial.printf("\nALERT *** ALERT *** ALERT\n");
    Serial.printf("Sender : % s\n", owoc.alert->senderName);
    Serial.printf("Event : % s\n", owoc.alert->event);
    Serial.printf("ALERT : % s\n", owoc.alert->summary);
  }
  else
  {
    Serial.printf("\nNo Alerts For Area, Alerts are EXCLUDED, or Alerts struct is empty\n");
  }

  // The following sections are separate from CURRENT and are turned off and on with their own flags

  if (owoc.timestamp)
  { // Check if data is in the struct for all variables before using them
    Serial.printf("\nTIMESTAMP - Single day weather for any date from 01-01-1979 to 4 days in future\n");
    Serial.printf("% s - % s\nTemperature: % .0f\nFeels like: % .0f\nHumidity: % .0F%%\n", owoc.timestamp[0].weekDayName, owoc.timestamp[0].readableDateTime, owoc.timestamp[0].temperature, owoc.timestamp[0].apparentTemperature, owoc.timestamp[0].humidity);
  }
  else
    Serial.printf("\nTIMESTAMP IS OFF or EMPTY\n");

  if (owoc.overView) // Check if data is in the struct for all variables before using them
  {
    Serial.printf("\nOVERVIEW - Summary for TODAY or TOMORROW generated by AI\n");

    // Print the struct values to verify
    Serial.printf("Latitude: %.6f\n", owoc.overView->lat); // %.6f for printing double with 6 decimal places
    Serial.printf("Longitude: %.6f\n", owoc.overView->lon);
    Serial.printf("Timezone: %s\n", owoc.overView->tz); // %s for const char* (string)
    Serial.printf("Date: %s\n", owoc.overView->date);
    Serial.printf("Units: %s\n", owoc.overView->units);
    Serial.printf("Weather Overview: %s\n", owoc.overView->weather_overview);
  }
  else
    Serial.printf("\nOVERVIEW IS OFF or EMPTY\n");

  if (owoc.quality) // Check if data is in the struct for all variables before using them
  {
    Serial.printf("\nAir Quality and Pollution Numbers for today");
    Serial.printf("\nAir Quality : % d\n", owoc.quality->aqi);
    Serial.printf("Carbon : % .2f\n", owoc.quality->co);
    Serial.printf("Nitrogen : % .2f\n", owoc.quality->no);
    Serial.printf("Ozone : % .2f\n", owoc.quality->o3);
  }
  else
    Serial.printf("\nAIR QUALITY IS OFF or EMPTY\n");


   */

  return true;
} // End owocParseWeather()

