void BME280get()
{
  // read temperature, humidity and pressure from BME280
  debug("Temperature = ");
  LocalWeatherTemp_C = bme.readTemperature();             // Read the temperature from the BME280 in Celsius
  LocalWeatherTemp_F = (LocalWeatherTemp_C * 1.8) + 32.0; // Convert to Fahrenheit
  LocalWeatherTemp_K = LocalWeatherTemp_C + 273.15;       // Convert to Kelvin
  debug(LocalWeatherTemp_C);
  debugln(" °C");
  debug("Temperature = ");
  debug(LocalWeatherTemp_F);
  debugln(" °F");
  debug("Temperature = ");
  debug(LocalWeatherTemp_K);
  debugln(" °K");

  debug("Pressure = ");
  LocalWeatherPressure_hPa = bme.readPressure() / 100.0F;          // Read the pressure from the BME280 in Pascals then convert to hPa
  LocalWeatherPressure_inHg = LocalWeatherPressure_hPa * 0.02953;  // Convert to inches of mercury
  LocalWeatherPressure_mmHg = LocalWeatherPressure_hPa * 0.750062; // Convert to mm of mercury
  debug(LocalWeatherPressure_hPa);
  debugln(" hPa");
  debug("Pressure = ");
  debug(LocalWeatherPressure_inHg);
  debugln(" inHg");
  debug("Pressure = ");
  debug(LocalWeatherPressure_mmHg);
  debugln(" mmHg");

  debug("Approx. Altitude = ");
  LocalWeatherAltitude = bme.readAltitude(SEALEVELPRESSURE_HPA); // Read the altitude from the BME280 in meters
  debug(LocalWeatherAltitude);
  debugln(" m");

  debug("Humidity = ");
  LocalWeatherHumidity = bme.readHumidity(); // Read the humidity from the BME280 in percent
  debug(LocalWeatherHumidity);
  debugln(" %");

  EVENT_JOB_BME = setEvent(BME280get, myTZ.now() + 300); // Set an event to retry the BME280 setup in 5 minutes

  if (EVENT_JOB_BME >= 1 && EVENT_JOB_BME <= 8)
  {
    debug("BME280 event ");
    debug(EVENT_JOB_BME);
    debugln(" running again in 5 minutes");
  }
  else
  {
    debugln("Failed to set event for BME280");
  }

  return;
} // End BME280get()

